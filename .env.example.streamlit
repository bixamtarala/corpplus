# CropPulse Phase 2 - Streamlit Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/croppulse_phase2

# For Railway.app PostgreSQL
# Get from: https://railway.app/project/[PROJECT_ID]/databases
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=true

# ============================================================================
# SECURITY & SECRETS
# ============================================================================

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_change_in_production

# API Key for internal backend calls
API_KEY=croppulse_admin_secret_key_12345

# ============================================================================
# EXTERNAL API CREDENTIALS
# ============================================================================

# eNAM API (Indian agricultural market data)
ENAM_API_URL=https://api.enam.gov.in/api
ENAM_API_KEY=your_enam_api_key

# Weather API (OpenWeatherMap or similar)
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# SMS/WhatsApp Notifications (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# PAYMENT GATEWAY
# ============================================================================

# Razorpay (Indian payment gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe (optional)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP for email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@croppulse.com

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================================================
# REDIS CACHE (Optional, for performance)
# ============================================================================

REDIS_URL=redis://localhost:6379/0
# For Railway Redis: redis://default:[PASSWORD]@[HOST]:[PORT]

# ============================================================================
# ENVIRONMENT
# ============================================================================

ENV=development
# production | staging | development

DEBUG=true
# Set to false in production

LOG_LEVEL=INFO
