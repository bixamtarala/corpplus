# CropPulse Phase 2 Backend - Environment Variables
# Copy this file to .env and fill in actual values
# Never commit actual .env to GitHub (only .env.example)

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENV=production
DEBUG=false
PORT=8000

# ============================================================================
# SECURITY - API KEYS
# ============================================================================
# Generate secure keys with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_ADMIN=croppulse_admin_secret_key_12345
API_KEY_FARMER=croppulse_farmer_secret_key_12345
API_KEY_TRADER=croppulse_trader_secret_key_12345

# JWT Configuration
JWT_SECRET=change_me_in_production_12345678
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/croppulse_db
# Optional dedicated URL for the mobile commerce schema. When set, this takes
# precedence over DATABASE_URL for commerce migrations and API sessions.
COMMERCE_DATABASE_URL=postgresql://user:password@localhost:5432/croppulse_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# ============================================================================
# CACHE - Redis
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@croppulse.com

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Weather API
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org

# eNAM API (Agricultural Commodities)
ENAM_API_KEY=your_enam_api_key
ENAM_API_URL=https://api.enam.gov.in

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================
FRONTEND_URL=https://croppulse.streamlit.app
LANDING_PAGE_URL=https://croppulse.com
ADMIN_DASHBOARD_URL=https://admin.croppulse.com

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================================================
# ML MODEL PATHS
# ============================================================================
PRICE_FORECAST_MODEL_PATH=/models/price_forecast_model.pkl
DEMAND_PREDICTION_MODEL_PATH=/models/demand_prediction_model.pkl
DISEASE_DETECTION_MODEL_PATH=/models/disease_detection_model.pkl

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_DAY=10000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_OTP_LOGIN=true
ENABLE_MARKETPLACE=true
ENABLE_PRICE_FORECASTING=true
ENABLE_DISEASE_DETECTION=true
ENABLE_FARMER_OS=true
ENABLE_TRADER_OS=true
